{
  "name": "saber11-visual",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "validar": "vitest run tests/packs.test.ts tests/content.test.ts tests/lab.test.ts",
    "typecheck": "tsc --noEmit",
    "gen": "tsx tools/generate/claude-gen.ts",
    "queue": "tsx tools/generate/queue.ts",
    "db:init": "wrangler d1 execute saber11 --file=schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.80.0"
  }
}
